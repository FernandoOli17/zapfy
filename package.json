{
  "name": "zapai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:migrate": "pnpm --filter @zapai/db db:migrate",
    "db:generate": "pnpm --filter @zapai/db db:generate",
    "db:seed": "pnpm --filter @zapai/db seed",
    "db:seed:granvilla": "pnpm --filter @zapai/db seed:granvilla",
    "db:studio": "pnpm --filter @zapai/db db:studio",
    "db:push": "pnpm --filter @zapai/db db:push",
    "db:reset": "pnpm --filter @zapai/db exec prisma migrate reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
