# =========================================
# Zapfy — env vars STAGING (Vercel + Railway)
# =========================================
#
# Como usar:
#   1. Copie este arquivo, renomeie pra .env.staging localmente
#   2. Preencha cada valor (instrução em cada bloco)
#   3. No Vercel dashboard: Settings → Environment Variables →
#      Add cada par KEY=VALUE com escopo "Preview" e "Production"
#   4. No Railway worker: idem via dashboard
#
# Valores marcados [MOCK] podem ficar como estão pra subir staging
# em modo demonstração — sem cobrar APIs externas.

# ───────────────────────────────────────────────────────────────
# OBRIGATÓRIAS — sem isso o app não sobe
# ───────────────────────────────────────────────────────────────

# URL pública do staging (Vercel dá um *.vercel.app gratuito)
NEXT_PUBLIC_APP_URL=https://zapfy-staging.vercel.app

NODE_ENV=production

# Neon Postgres (https://console.neon.tech/) — use a branch "staging"
# Format: postgresql://user:pass@host.neon.tech/db?sslmode=require
DATABASE_URL=

# Upstash Redis (https://console.upstash.com/) — cluster mesma região da Vercel
# Format: rediss://default:token@host.upstash.io:6379
REDIS_URL=

# Better Auth — gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://zapfy-staging.vercel.app

# Crypto pra cifrar tokens Meta no DB — openssl rand -hex 32
ENCRYPTION_KEY=

# Hashing de PII em logs (telefone) — openssl rand -hex 16
LOG_PII_SALT=

# ───────────────────────────────────────────────────────────────
# MODO DEMO — deixe true em staging se ainda não tem creds reais
# ───────────────────────────────────────────────────────────────

# Agente IA retorna respostas canned (sem chamar Anthropic)
MOCK_AI=true

# Billing bypassed (UI mostra "modo demo", sem chamar Stripe)
STRIPE_MOCK=true

# ───────────────────────────────────────────────────────────────
# RECOMENDADAS — funcionam sem mas degradam features
# ───────────────────────────────────────────────────────────────

# Pusher Channels (https://dashboard.pusher.com)
# Sem essas, inbox cai em polling de 5s (já tem fallback). Real-time
# requer App ID + Key + Secret + cluster.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=sa1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=sa1

# Upstash REST API (mesmo dashboard do Redis) — pra rate-limit em prod
# Sem isso, rate-limit é no-op (permite tudo). Aceitável demo, NÃO prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (https://resend.com) — emails transacionais
# Sem RESEND_API_KEY, emails só logam no console (não vão pro user).
RESEND_API_KEY=
RESEND_FROM_EMAIL=ola@zapfy.com.br

# Sentry (https://sentry.io) — captura erros em prod
# Sem isso, erros só vão pros logs do Vercel/Railway sem alerta.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (https://posthog.com) — product analytics
# Sem NEXT_PUBLIC_POSTHOG_KEY, client posthog não inicia.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Token (>=24 chars) pra /api/health?token=<...> detalhado — openssl rand -hex 16
HEALTH_DETAIL_TOKEN=

# ───────────────────────────────────────────────────────────────
# OPCIONAIS — pra quando tiver primeiros clientes pagantes
# ───────────────────────────────────────────────────────────────

# Anthropic (necessário quando MOCK_AI=false)
ANTHROPIC_API_KEY=

# Voyage AI — embeddings para RAG
VOYAGE_API_KEY=

# Stripe production (necessário quando STRIPE_MOCK=false)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# UploadThing — uploads de imagens/mídia
UPLOADTHING_TOKEN=

# Google OAuth (botão "Continuar com Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta WhatsApp — modelo BYO no MVP (cliente cadastra no UI),
# essas vars só entram quando migrarmos pra Tech Provider.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
