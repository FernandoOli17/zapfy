# =========================================
# Zapfy — variáveis de ambiente (template)
# Copie pra .env (dev) ou .env.local (web) e preencha
# Pra staging Vercel: veja .env.staging
# =========================================

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# === Database ===
# Postgres 16 com extensão pgvector. Em dev: docker compose up -d
# Em prod/staging: Neon (HTTPS via porta 443)
DATABASE_URL=postgresql://zapfy:zapfy@localhost:5432/zapfy?schema=public

# === Redis (BullMQ) ===
# Em dev: docker compose up -d. Em prod: Upstash redis://
REDIS_URL=redis://localhost:6379

# === Auth (Better Auth) ===
# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Anthropic — https://console.anthropic.com ===
ANTHROPIC_API_KEY=
# Quando ANTHROPIC_API_KEY vazia, ativar modo determinístico (custo zero)
MOCK_AI=false

# === Voyage AI — https://dash.voyageai.com ===
VOYAGE_API_KEY=

# === WhatsApp / Meta ===
# Modelo BYO no MVP: cada workspace cola suas credenciais via UI (cifradas no DB).
# Estas vars globais ficam vazias por enquanto — entram quando migrarmos pra
# Tech Provider + Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# === Stripe — https://dashboard.stripe.com/apikeys ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
# Quando STRIPE_SECRET_KEY vazia ou pra demo, ativar:
STRIPE_MOCK=false

# === Storage — https://uploadthing.com ===
UPLOADTHING_TOKEN=

# === Email — https://resend.com ===
RESEND_API_KEY=
RESEND_FROM_EMAIL=ola@zapfy.com.br

# === Real-time — https://dashboard.pusher.com ===
# Cluster sa1 (São Paulo) recomendado pra latência BR
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=sa1
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=sa1

# === Upstash REST (rate-limit production) — opcional em dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Crypto ===
# Gere com: openssl rand -hex 32 (resultado deve ter 64 chars hex = 32 bytes)
ENCRYPTION_KEY=
# Salt pra hashing de PII em logs (telefone). Gere também com openssl rand -hex 16
LOG_PII_SALT=

# === Health detail endpoint ===
# Token (>=24 chars) pra /api/health?token=... detalhado. Gere com openssl rand -hex 16.
HEALTH_DETAIL_TOKEN=

# === Observabilidade ===
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
