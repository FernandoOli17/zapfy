// ZapAI — schema completo
// pgvector via Prisma postgresqlExtensions (preview)
// Vetor: vector(1024) — voyage-3
//
// Convenções:
// - id = cuid()
// - timestamps createdAt/updatedAt obrigatórios
// - soft delete (deletedAt) em entidades sensíveis
// - workspaceId FK em tudo que é tenant-scoped, com index
// - jsonb em metadados livres

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// =========================================
// AUTH (Better Auth)
// =========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  /// Acesso global a todos os workspaces via /admin. Toggle SÓ manual no DB.
  isSuperAdmin  Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  workspaceMembers  WorkspaceMember[]
  assignedConvos    Conversation[]    @relation("assignedTo")
  auditLogs         AuditLog[]
  forgeSessions     ForgeSession[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// =========================================
// WORKSPACE / TENANTS
// =========================================

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
}

model Workspace {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Quando true, libera a página /developer (flow editor, custom tools,
  /// raw prompt). Toggle só por OWNER/ADMIN. Default false: experiência
  /// guiada via Forge.
  developerModeEnabled Boolean @default(false)

  members           WorkspaceMember[]
  subscription      Subscription?
  whatsappAccounts  WhatsAppAccount[]
  contacts          Contact[]
  conversations     Conversation[]
  messages          Message[]
  agents            Agent[]
  forgeSessions     ForgeSession[]
  knowledgeDocs     KnowledgeDocument[]
  products          Product[]
  tags              Tag[]
  apiKeys           ApiKey[]
  outgoingWebhooks  OutgoingWebhook[]
  auditLogs         AuditLog[]
  usageRecords      UsageRecord[]
  messageTemplates  MessageTemplate[]
  broadcasts        Broadcast[]
  customTools       CustomTool[]
  // Fase 7 — Playbooks por vertical
  orders            Order[]
  coupons           Coupon[]
  professionals     Professional[]
  appointments      Appointment[]
  quotes            Quote[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(AGENT)
  invitedAt   DateTime?
  joinedAt    DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// =========================================
// BILLING
// =========================================

enum PlanId {
  STARTER
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  plan                 PlanId             @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  trialEndsAt          DateTime?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageRecord {
  id          String   @id @default(cuid())
  workspaceId String
  kind        String   // 'ai_message' | 'embedding' | 'whatsapp_send'
  quantity    Int      @default(1)
  tokensIn    Int?
  tokensOut   Int?
  costCents   Int?     // custo estimado em USD cents
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, kind, createdAt])
}

// =========================================
// WHATSAPP
// =========================================

enum WhatsAppStatus {
  PENDING
  CONNECTED
  ERROR
  DISCONNECTED
}

model WhatsAppAccount {
  id                     String         @id @default(cuid())
  workspaceId            String
  phoneNumberId          String         @unique // Meta phone_number_id
  businessAccountId      String         // Meta WABA id
  displayPhone           String
  accessTokenEncrypted   String         // AES-256-GCM
  appSecretEncrypted     String         // AES-256-GCM
  webhookVerifyToken     String         // por workspace, gerado no connect
  status                 WhatsAppStatus @default(PENDING)
  lastErrorMessage       String?
  connectedAt            DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// =========================================
// CONTACTS / CONVERSATIONS / MESSAGES
// =========================================

model Contact {
  id           String    @id @default(cuid())
  workspaceId  String
  phoneE164    String    // sem +, só dígitos
  name         String?
  email        String?
  tags         String[]  @default([])
  customFields Json      @default("{}")
  optedOut     Boolean   @default(false)
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  hardDeleteAt DateTime? // agendado p/ LGPD

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  broadcastRecipients BroadcastRecipient[]
  // Fase 7
  orders        Order[]
  appointments  Appointment[]
  quotes        Quote[]

  @@unique([workspaceId, phoneE164])
  @@index([workspaceId])
}

enum ConversationStatus {
  AI_HANDLING
  HUMAN_HANDLING
  CLOSED
}

model Conversation {
  id                     String             @id @default(cuid())
  workspaceId            String
  contactId              String
  status                 ConversationStatus @default(AI_HANDLING)
  assignedToUserId       String?
  lastMessageAt          DateTime?
  lastIncomingMessageAt  DateTime?
  unreadCount            Int                @default(0)
  internalNotes          String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("assignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   Message[]
  // Fase 7
  orders        Order[]
  appointments  Appointment[]
  quotes        Quote[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([contactId])
  @@index([assignedToUserId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOC
  VIDEO
  TEMPLATE
  INTERACTIVE
  LOCATION
  CONTACTS
  STICKER
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id                 String           @id @default(cuid())
  workspaceId        String
  conversationId     String
  contactId          String
  direction          MessageDirection
  type               MessageType      @default(TEXT)
  content            Json             // { text?: string, mediaUrl?, caption?, ... }
  status             MessageStatus    @default(PENDING)
  whatsappMessageId  String?          @unique
  fromAi             Boolean          @default(false)
  toolsUsed          String[]         @default([])
  tokensIn           Int?
  tokensOut          Int?
  costCents          Int?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

// =========================================
// AGENT / FORGE
// =========================================

enum Vertical {
  ECOMMERCE
  CLINIC
  RESTAURANT
  INFOPRODUCT
  SERVICE
  OTHER
}

model Agent {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  vertical     Vertical  @default(OTHER)
  playbookId   String?
  currentVersionId String? @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions       AgentVersion[] @relation("agentVersions")
  currentVersion AgentVersion?  @relation("currentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model AgentVersion {
  id              String   @id @default(cuid())
  agentId         String
  versionNumber   Int
  systemPrompt    String
  personality     Json     // { tone, language, emoji, neverSay, ... }
  toolsEnabled    String[] @default([])
  handoffRules    Json     // { keywords, conditions, ... }
  businessHours   Json?    // { timezone, days: {...} }
  changeNotes     String?
  createdByUserId String?
  forgeSessionId  String?
  /// Grafo de fluxo customizado (modo desenvolvedor). Quando preenchido,
  /// substitui o pipeline default (classifier → RAG → agent). Formato:
  /// { nodes: FlowNode[], edges: FlowEdge[] }. Validação Zod em
  /// `@zapai/ai/flow`.
  flowGraph       Json?
  /// IDs de CustomTool habilitadas nessa versão. Cada nome é resolvido
  /// pelo worker contra Workspace.customTools.
  customToolNames String[] @default([])
  createdAt       DateTime @default(now())

  agent       Agent          @relation("agentVersions", fields: [agentId], references: [id], onDelete: Cascade)
  currentFor  Agent?         @relation("currentVersion")
  forgeSession ForgeSession? @relation(fields: [forgeSessionId], references: [id], onDelete: SetNull)

  @@unique([agentId, versionNumber])
  @@index([agentId])
}

/// Ferramenta customizada criada pelo dev. Quando o agente invoca,
/// fazemos POST HTTP no `endpoint` com HMAC SHA-256 assinado pelo
/// `secretHash` (hash do segredo cru — o segredo só aparece pro usuário
/// uma vez na criação).
model CustomTool {
  id            String   @id @default(cuid())
  workspaceId   String
  /// Nome usado pelo agente IA — letras minúsculas, underscores. Único por workspace.
  name          String
  /// Descrição que o LLM lê pra decidir quando invocar.
  description   String
  /// JSON Schema dos argumentos. Validado em runtime.
  inputSchema   Json
  /// URL HTTPS que recebe POST quando a tool é chamada.
  endpoint      String
  /// SHA-256 do secret HMAC. Segredo cru nunca persistido.
  secretHash    String
  /// Prefixo visível pra identificar (ex: `cs_a1b2c3`).
  secretPrefix  String
  /// Header HTTP que carrega a assinatura (default `x-trato-signature`).
  signatureHeader String  @default("x-trato-signature")
  /// Timeout em ms pra resposta. Default 10s.
  timeoutMs     Int      @default(10000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, active])
}

enum ForgePhase {
  DISCOVERY
  VERTICAL_DETECTION
  GOALS
  TONE
  KNOWLEDGE
  TOOLS
  HANDOFF
  REVIEW
  PUBLISH
  REFINEMENT
}

enum ForgeStatus {
  IN_PROGRESS
  PUBLISHED
  ABANDONED
}

model ForgeSession {
  id               String      @id @default(cuid())
  workspaceId      String
  userId           String?
  status           ForgeStatus @default(IN_PROGRESS)
  currentPhase     ForgePhase  @default(DISCOVERY)
  transcript       Json        // [{ role, content, toolCalls?, ... }]
  collectedAnswers Json        @default("{}")
  generatedAgentVersionId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentVersions  AgentVersion[]

  @@index([workspaceId])
}

// =========================================
// KNOWLEDGE / RAG
// =========================================

enum KnowledgeSource {
  UPLOAD
  URL
  MANUAL
}

enum KnowledgeDocStatus {
  PROCESSING
  READY
  ERROR
}

model KnowledgeDocument {
  id          String             @id @default(cuid())
  workspaceId String
  title       String
  source      KnowledgeSource
  sourceUrl   String?
  status      KnowledgeDocStatus @default(PROCESSING)
  fileKey     String?            // storage (UploadThing)
  errorMessage String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunk[]

  @@index([workspaceId])
}

model KnowledgeChunk {
  id         String                       @id @default(cuid())
  documentId String
  content    String
  // pgvector — voyage-3 = 1024 dims
  embedding  Unsupported("vector(1024)")?
  tokens     Int?
  metadata   Json?
  createdAt  DateTime                     @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// =========================================
// COMMERCE (Products, Tags)
// =========================================

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  priceCents  Int?
  currency    String   @default("BRL")
  imageUrl    String?
  checkoutUrl String?
  sku         String?
  stock       Int?
  category    String?  // pra filtrar list_products / cardápio
  metadata    Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, active])
  @@index([workspaceId, category])
}

// =========================================
// COMMERCE — Order / Coupon (ECOMMERCE + RESTAURANT)
// =========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  workspaceId     String
  contactId       String?
  conversationId  String?
  /// Número curto exposto ao cliente (#PED-1234)
  publicNumber    String
  status          OrderStatus @default(PENDING)
  /// Total final em centavos (após cupom + frete)
  totalCents      Int         @default(0)
  /// Subtotal antes de cupom/frete
  subtotalCents   Int         @default(0)
  shippingCents   Int         @default(0)
  discountCents   Int         @default(0)
  currency        String      @default("BRL")
  couponCode      String?
  /// Endereço de entrega (estruturado)
  shippingAddress Json?       // { street, number, complement, neighborhood, city, state, zip, reference }
  paymentMethod   String?     // 'pix' | 'card_on_delivery' | 'card_online'
  /// ETA estimado em minutos a partir de createdAt
  etaMinutes      Int?
  /// Observações do cliente
  notes           String?
  externalId      String?     // id do PDV / iFood / Shopify
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        OrderItem[]

  @@unique([workspaceId, publicNumber])
  @@index([workspaceId, status, createdAt])
  @@index([contactId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  /// Nome no momento da compra (preserva se Product mudar depois)
  nameSnapshot String
  unitPriceCents Int
  quantity    Int
  notes       String? // observação do item ("sem cebola", "ponto da carne")
  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum CouponDiscountType {
  PERCENT
  FIXED_CENTS
}

model Coupon {
  id              String              @id @default(cuid())
  workspaceId     String
  code            String              // case-insensitive na lookup
  discountType    CouponDiscountType
  /// se PERCENT: 1-100; se FIXED_CENTS: valor em centavos
  discountValue   Int
  /// Valor mínimo de compra pra aplicar
  minSubtotalCents Int?
  /// Quantidade máxima de usos. NULL = ilimitado.
  maxRedemptions  Int?
  redeemedCount   Int                 @default(0)
  expiresAt       DateTime?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

// =========================================
// CLINIC — Appointments
// =========================================

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Professional {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  specialty   String?
  email       String?
  /// Token OAuth Google Calendar cifrado AES-256-GCM
  googleCalendarTokenEncrypted String?
  googleCalendarId             String? // ID do calendário no Google
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([workspaceId, active])
}

model Appointment {
  id              String            @id @default(cuid())
  workspaceId     String
  professionalId  String
  contactId       String?
  conversationId  String?
  status          AppointmentStatus @default(SCHEDULED)
  /// Início da consulta (timezone-aware)
  startsAt        DateTime
  /// Duração em minutos
  durationMinutes Int               @default(30)
  /// Tipo: 'consulta', 'retorno', 'avaliacao', etc.
  type            String?
  notes           String?
  /// ID do evento no Google Calendar (se sincronizado)
  googleEventId   String?
  cancellationReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  professional Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, startsAt])
  @@index([professionalId, startsAt])
  @@index([contactId])
}

// =========================================
// SERVICE — Quote / Proposal
// =========================================

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id              String      @id @default(cuid())
  workspaceId     String
  contactId       String?
  conversationId  String?
  publicNumber    String
  status          QuoteStatus @default(DRAFT)
  /// Resumo do serviço pedido
  serviceDescription String
  /// Endereço de execução
  serviceAddress  Json?
  /// Itens da proposta com nome + qty + valor
  items           Json
  totalCents      Int         @default(0)
  currency        String      @default("BRL")
  validUntil      DateTime?
  /// URL do PDF (UploadThing)
  pdfUrl          String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, publicNumber])
  @@index([workspaceId, status, createdAt])
  @@index([contactId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
}

// =========================================
// STATUS PAGE — uptime + incidentes públicos
// =========================================

enum StatusComponent {
  API
  WORKER
  WHATSAPP
  DATABASE
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/**
 * Track de emails enviados por user/template — idempotência pra sequence.
 * Evita re-enviar day3/day6 pro mesmo user se worker re-rodar.
 */
model EmailSent {
  id          String   @id @default(cuid())
  userId      String
  templateKey String   // 'welcome' | 'day3_forge_nudge' | 'day6_trial_ending' | 'activation'
  resendId    String?  // ID retornado pela Resend (pra debug)
  sentAt      DateTime @default(now())

  @@unique([userId, templateKey])
  @@index([sentAt])
}

/**
 * Incidente registrado manualmente ou via auto-detect (worker que falha mais
 * de N vezes em sequência, DB down, etc.). Exibido em /status (rota pública).
 * Sem workspaceId — é status global do produto, não por tenant.
 */
model StatusIncident {
  id          String           @id @default(cuid())
  title       String
  description String?
  component   StatusComponent
  severity    IncidentSeverity @default(MINOR)
  startedAt   DateTime         @default(now())
  resolvedAt  DateTime?
  /// JSON array com timeline de updates: [{at, message}]
  updates     Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([startedAt])
  @@index([component, startedAt])
}

// =========================================
// API / WEBHOOKS / AUDIT
// =========================================

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyHash     String    @unique  // SHA-256 do segredo
  prefix      String    @unique  // 8 chars visíveis ('zk_xxxx')
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model OutgoingWebhook {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  secret      String   // HMAC signing key (encrypted at-rest? por agora claro)
  events      String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?
  userId      String?
  action      String   // 'agent.publish', 'whatsapp.connect', etc.
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  /// Detail pages filtram audit por (workspaceId, targetType, targetId)
  @@index([workspaceId, targetType, targetId])
  /// /admin filtra audit por action LIKE 'admin.%'
  @@index([action, createdAt])
}

// =========================================
// HSM TEMPLATES / BROADCASTS
// =========================================

enum TemplateStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAUSED
  DISABLED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

model MessageTemplate {
  id           String           @id @default(cuid())
  workspaceId  String
  metaTemplateId String?        @unique
  name         String
  language     String           @default("pt_BR")
  category     TemplateCategory
  components   Json             // header, body, footer, buttons
  status       TemplateStatus   @default(SUBMITTED)
  rejectionReason String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  broadcasts Broadcast[]

  @@unique([workspaceId, name, language])
  @@index([workspaceId, status])
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELED
  FAILED
}

model Broadcast {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  templateId  String
  variables   Json?           // mapeamento de variáveis por contato
  status      BroadcastStatus @default(DRAFT)
  scheduledFor DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   MessageTemplate      @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients BroadcastRecipient[]

  @@index([workspaceId, status])
}

enum BroadcastRecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model BroadcastRecipient {
  id          String                   @id @default(cuid())
  broadcastId String
  contactId   String
  status      BroadcastRecipientStatus @default(PENDING)
  whatsappMessageId String?
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
}
